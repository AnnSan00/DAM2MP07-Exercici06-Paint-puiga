<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>

<HBox xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.Controller">
    <children>
        <!-- Left: drawing area -->
        <Canvas fx:id="canvas" width="600.0" height="550.0" />

        <!-- Center: tools & options -->
        <VBox spacing="8.0" prefWidth="170.0" style="-fx-background-color: #eeeeee;">
            <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>
            <children>
                <Label text="Eines" style="-fx-font-weight: bold;" />
                <fx:define>
                    <ToggleGroup fx:id="toolGroup" />
                </fx:define>
                <RadioButton fx:id="freehandRadio" text="Traç lliure" toggleGroup="$toolGroup" selected="true" />
                <RadioButton fx:id="lineRadio" text="Línia" toggleGroup="$toolGroup" />
                <RadioButton fx:id="rectRadio" text="Rectangle" toggleGroup="$toolGroup" />

                <Separator />
                <Label text="Estil" style="-fx-font-weight: bold;" />
                <Label text="Color contorn:" />
                <ColorPicker fx:id="strokeColorPicker">
                    <value><Color fx:constant="BLACK" /></value>
                </ColorPicker>

                <Label text="Color emplenament:" />
                <ColorPicker fx:id="fillColorPicker">
                    <value><Color fx:constant="TRANSPARENT" /></value>
                </ColorPicker>

                <Label text="Ample línia:" />
                <Slider fx:id="widthSlider" min="1.0" max="30.0" value="3.0" showTickLabels="true" showTickMarks="true"/>

                <Separator />
                <Label text="Colors predefinits:" style="-fx-font-weight: bold;" />
                <Canvas fx:id="colorsCanvas" width="130.0" height="90.0" />            </children>
        </VBox>

        <!-- Right: objects list & delete button -->
        <VBox spacing="8.0" prefWidth="160.0">
            <padding><Insets top="10.0" right="10.0" bottom="10.0" left="10.0" /></padding>
            <children>
                <Label text="Objectes" style="-fx-font-weight: bold;" />
                <ListView fx:id="objectsListView" prefHeight="420.0" />
                <Button fx:id="deleteButton" text="Eliminar seleccionat" maxWidth="Infinity" disable="true" onAction="#handleDeleteObject" />
            </children>
        </VBox>
    </children>
</HBox>